{
  "version": 1,

  "_comment": "本文件为 csharp-test-coverage 的【引擎侧通用配置】，随引擎入库并在项目间共享：仅承载与具体项目无关的算法参数、映射策略与严重程度。所有【项目相关】内容（运行时源码根、排除路径、扫描范围、包名→命名空间映射、真实采集程序集前缀等）已外置到项目侧 .codebuddy.project/（见 .codebuddy/project.index.json 的 coverage.project_config）。运行时由 Python 脚本（scripts/skill_config.py）与 C# 工具（CoverageConfig.Load）加载本文件与项目侧文件并深度合并；项目侧值覆盖本文件值，数组按键合并。配置缺失、损坏或缺少必需字段时直接报错退出（退出码 3），不回退内置默认值。",

  "exclude": {
    "autoGenerated": true,
    "autoGeneratedScanLines": 5
  },

  "testRootMarkers": [
    "/Tests/"
  ],

  "memberScope": {
    "accessibilities": ["public", "internal"],
    "includePrivateMembers": false,
    "includeNestedTypes": true,
    "includeEnumValues": true,
    "skipCompilerGenerated": true,
    "skipPropertyAccessors": false,
    "skipEventAccessors": true,
    "skipOperators": false,
    "skipDestructors": true
  },

  "referenceStrength": {
    "weakReferenceKinds": [
      "XmlCref",
      "ReflectionStringMemberName"
    ],
    "countWeakAsCovered": false,
    "reflectionApiNames": [
      "GetField",
      "GetMethod",
      "GetProperty",
      "GetEvent",
      "GetMember",
      "GetNestedType",
      "GetType"
    ]
  },

  "matching": {
    "preferDirectoryMirror": true,
    "fallbackToNamespaceAndTypeName": true,
    "fallbackToTypeNameOnly": false,
    "runtimeRootName": "Runtime",
    "testRootNames": ["Tests/Editor", "Tests/Runtime"],
    "testFileSuffix": "Tests"
  },

  "skeleton": {
    "enabledByDefault": false,
    "requireConfirmation": true,
    "fileCountThreshold": 50,
    "inconclusiveMessage": "骨架用例：断言待补完。",
    "todoMarker": "TODO(待补完)",
    "partialTopicInference": true,
    "forbidNewFixtureWhenCounterpartExists": true,
    "checkPartialMemberConflicts": true
  },

  "realCoverage": {
    "reportSummaryJson": "CodeCoverage/Report/Summary.json",
    "reportSummaryXml": "CodeCoverage/Report/Summary.xml",
    "assemblyExcludeSuffixes": [".Tests", ".Tests.Editor"],
    "pathsToExclude": "**/Tests/**",
    "preferSummaryJson": true,
    "branchCoverageAvailable": false,
    "domainReloadWaitRounds": 12,
    "domainReloadWaitIntervalSeconds": 5
  },

  "severity": {
    "uncoveredMember": "warning",
    "uncoveredFile": "warning",
    "weakReferenceOnly": "info",
    "staticRealDivergence": "info",
    "noFrameworkAssemblyInRealCoverage": "error",
    "parseError": "error"
  }
}
