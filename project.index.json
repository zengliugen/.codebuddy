    "rules/core/core-project-guide/testing.mdc": {
      "path": ".codebuddy.project/configs/rules/core/core-project-guide/testing.mdc",
      "format": "markdown",
      "template_outline": [
        "# 测试约束",
        "## 运行环境限制",
        "## 断言与测试运行器",
        "## 资源与性能约束"
      ]
