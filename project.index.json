    },
    "rules/core/core-project-guide/git-ignore.mdc": {
      "path": ".codebuddy.project/configs/rules/core/core-project-guide/git-ignore.mdc",
      "format": "markdown",
      "template_outline": [
        "# Git 忽略内容清单",
