{
  "version": 1,
  "_comment": "引擎包注册表，随引擎入库共享。comps 只写组件名，实际路径由 location 推导：engine → .codebuddy/<类型>/<pack>/<名>；lib → .codebuddy/lib/<pack>/<类型>/<名>；project → .codebuddy.project/<类型>/<pack>/<名>（agents 均加 .md 后缀；规则入口形态为 <名>.entry/ 目录）。",
  "packs": {
    "core": {
      "category": "基础",
      "description": "任何项目必装：语言与编码规范、项目指导薄壳、初始化能力",
      "default": true,
      "location": "engine",
      "requires": [],
      "comps": {
        "rules": [
          "core-language",
          "core-project-guide",
          "core-tooling",
          "core-engine",
          "core-init",
          "core-rule-governance"
        ],
        "skills": [
          "core-init"
        ],
        "agents": []
      }
    },
    "vcs": {
      "category": "基础",
      "description": "版本控制路由与提交、合并执行",
      "default": true,
      "location": "engine",
      "requires": [
        "core"
      ],
      "comps": {
        "rules": [
          "vcs-router",
          "vcs-engine-commit",
          "vcs-git-commit",
          "vcs-git-merge"
        ],
        "skills": [
          "vcs-router",
          "vcs-git-commit",
          "vcs-git-merge"
        ],
        "agents": []
      }
    },
    "tool": {
      "category": "基础",
      "description": "引擎自维护规则与通用工具技能",
      "default": true,
      "location": "engine",
      "requires": [
        "core"
      ],
      "comps": {
        "rules": [
          "tool-cmd-script-writing",
          "tool-engine-sync",
          "tool-export-zipped-dir",
          "tool-rule-consolidation",
          "tool-session-lesson-distill"
        ],
        "skills": [
          "tool-cmd-script-writing",
          "tool-engine-sync",
          "tool-export-zipped-dir",
          "tool-rule-consolidation",
          "tool-session-lesson-distill"
        ],
        "agents": []
      }
    },
    "project": {
      "category": "项目专属",
      "description": "项目自有的规则、技能与代理；内容直接放 .codebuddy.project/project/ 下，随项目入库，默认启用",
      "default": true,
      "location": "project",
      "requires": [],
      "comps": {
        "rules": [],
        "skills": [],
        "agents": []
      }
    },
    "csharp": {
      "category": "C#",
      "description": "C# 全套：代码审查链、注释规范、格式检查、LSP、测试覆盖率",
      "default": false,
      "location": "lib",
      "requires": [
        "core",
        "vcs"
      ],
      "comps": {
        "rules": [
          "csharp-code-review",
          "csharp-comment",
          "csharp-lsp",
          "csharp-test",
          "csharp-test-coverage",
          "csharp-format-checker"
        ],
        "skills": [
          "csharp-code-review",
          "csharp-comment-checker",
          "csharp-comment-generator",
          "csharp-format-checker",
          "csharp-lsp",
          "csharp-test-coverage"
        ],
        "agents": [
          "csharp-code-review",
          "csharp-comment-generator"
        ]
      }
    },
    "unity-pipeline": {
      "category": "领域（本地维护）",
      "description": "Unity 实例打开、编译、测试、热重载；源出上游 com.unity.pipeline，正文已中文化",
      "default": false,
      "location": "lib",
      "requires": [
        "core"
      ],
      "comps": {
        "rules": [
          "unity-pipeline"
        ],
        "skills": [
          "unity-pipeline"
        ],
        "agents": []
      }
    },
    "grilling": {
      "category": "third-party（本地维护）",
      "description": "诘问式方案压测：设计树逐轮追问，把方案中的未定项显式化；源出上游 grilling，正文已中文化",
      "default": false,
      "location": "lib",
      "requires": [],
      "comps": {
        "rules": [],
        "skills": [
          "grilling"
        ],
        "agents": []
      }
    },
    "yao-meta-skill": {
      "category": "third-party",
      "description": "技能创建、改进与评估的元技能",
      "default": false,
      "location": "lib",
      "requires": [],
      "comps": {
        "rules": [
          "yao-meta-skill"
        ],
        "skills": [
          "yao-meta-skill"
        ],
        "agents": []
      }
    },
    "python": {
      "category": "Python",
      "description": "Python 全套：ruff 检查、代码审查、注释规范、测试覆盖率",
      "default": false,
      "location": "lib",
      "requires": [
        "core",
        "vcs"
      ],
      "comps": {
        "rules": [
          "python-code-review",
          "python-comment",
          "python-test",
          "python-env",
          "python-lint",
          "python-test-coverage"
        ],
        "skills": [
          "python-env",
          "python-lint",
          "python-code-review",
          "python-comment",
          "python-test-coverage"
        ],
        "agents": [
          "python-code-review"
        ]
      }
    }
  }
}
