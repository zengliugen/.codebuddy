    },
    "inline_algorithm": {
      "enabled": false,
      "description": "算法/数据结构选择缺少行内注释（启发式判断，默认禁用）",
      "issues": {
        "inline_algorithm": {
          "enabled": true,
          "severity": "info",
          "description": "使用特定数据结构缺少行内注释解释选择原因"
