    "doc_block_comment_format": {
      "enabled": true,
      "description": "文档注释使用了禁止的 /** */ 块注释格式",
      "issues": {
        "block_comment_format": {
          "enabled": true,
          "severity": "warning",
          "description": "文档注释使用了禁止的 /** */ 格式，应改用 ///"
        }
      }
    },
    "file_header": {
      "enabled": true,
      "description": "文件头注释检查",
      "issues": {
        "file_header": {
          "enabled": true,
          "severity": "warning",
          "description": "缺少文件头注释"
        }
      }
    },
    "inline_condition": {
      "enabled": true,
      "description": "条件分支缺少行内注释",
      "issues": {
        "inline_condition": {
          "enabled": true,
          "severity": "warning",
          "description": "非显而易见的条件分支缺少行内注释解释判断意图"
        }
      }
    },
    "inline_loop_control": {
      "enabled": true,
      "description": "循环控制缺少行内注释",
