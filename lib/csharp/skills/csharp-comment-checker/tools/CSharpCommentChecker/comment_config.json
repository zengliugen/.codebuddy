          "description": "方法缺少 XML 文档注释"
        },
        "missing_summary": {
          "enabled": true,
          "severity": "error",
          "description": "缺少 <summary> 标签"
        },
        "summary_no_period": {
          "enabled": true,
          "severity": "warning",
          "description": "<summary> 内容不以句号（。）结尾"
        },
        "missing_param": {
          "enabled": true,
          "severity": "warning",
          "description": "方法参数缺少 <param> 文档注释"
        },
        "missing_return": {
          "enabled": true,
          "severity": "warning",
          "description": "有返回值的方法缺少 <returns> 文档注释"
        },
        "missing_typeparam": {
          "enabled": true,
          "severity": "warning",
          "description": "泛型方法缺少 <typeparam> 文档注释"
        },
        "language": {
