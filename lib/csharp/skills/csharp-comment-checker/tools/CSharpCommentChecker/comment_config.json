{
  "_comment": "本文件为 csharp-comment-checker 的【引擎侧通用配置】，随引擎入库并在项目间共享：承载全部检查规则（rules）与通用开关。所有【项目相关】内容（exclude.paths 排除目录、knownTerms 项目术语）已外置到项目侧 .codebuddy.project/（见 .codebuddy/project.index.json 的 comment.project_config）。运行时由 C# 工具（CommentRules.Load）加载本文件与项目侧文件并深度合并；项目侧值覆盖本文件值，数组取并集。配置缺失、损坏或缺少字段时直接报错退出（退出码 3），不回退内置默认配置。",
  "exclude": {
    "autoGenerated": true
  },
  "rules": {
    "doc_missing_class": {
      "enabled": true,
      "description": "类缺少 XML 文档注释",
      "issues": {
        "missing_doc_comment": {
          "enabled": true,
          "severity": "error",
          "description": "类缺少 XML 文档注释"
        }
      }
    },
    "doc_missing_interface": {
      "enabled": true,
      "description": "接口缺少 XML 文档注释",
      "issues": {
        "missing_doc_comment": {
          "enabled": true,
          "severity": "error",
          "description": "接口缺少 XML 文档注释"
        }
      }
    },
    "doc_missing_struct": {
      "enabled": true,
      "description": "结构体缺少 XML 文档注释",
      "issues": {
        "missing_doc_comment": {
          "enabled": true,
          "severity": "error",
          "description": "结构体缺少 XML 文档注释"
        }
      }
    },
    "doc_missing_enum": {
      "enabled": true,
      "description": "枚举缺少 XML 文档注释",
      "issues": {
        "missing_doc_comment": {
          "enabled": true,
          "severity": "error",
          "description": "枚举类型缺少 XML 文档注释"
        },
        "missing_summary": {
          "enabled": true,
          "severity": "error",
          "description": "缺少 <summary> 标签"
        },
        "summary_no_period": {
          "enabled": true,
          "severity": "warning",
          "description": "<summary> 内容不以句号（。）结尾"
        },
        "missing_typeparam": {
          "enabled": true,
          "severity": "warning",
          "description": "泛型类型缺少 <typeparam> 文档注释"
        },
        "language": {
          "enabled": true,
          "severity": "warning",
          "description": "注释内容应使用简体中文"
        },
        "typeparam_mismatch": {
          "enabled": true,
          "severity": "warning",
          "description": "<typeparam> 标签名称与实际类型参数名不一致"
        }
      }
    },
    "doc_missing_enum_value": {
      "enabled": true,
      "description": "枚举值缺少 XML 文档注释",
      "issues": {
        "missing_doc_comment": {
          "enabled": true,
          "severity": "error",
          "description": "枚举值缺少 XML 文档注释"
        }
      }
    },
    "doc_missing_delegate": {
      "enabled": true,
